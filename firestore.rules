rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis() {
      return request.auth != null;
    }

    function adminMi() {
      return girisYapmis()
        && request.auth.uid == "Et5cFLiQNtgMdQcWIAcaQIOpQBe2";
    }

    function onayliKurumKullanicisi() {
      return girisYapmis()
        && exists(
          /databases/$(database)/documents/institutionUsers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/institutionUsers/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/institutionUsers/$(request.auth.uid)
        ).data.institutionId is string;
    }

    function bagliKurumId() {
      return get(
        /databases/$(database)/documents/institutionUsers/$(request.auth.uid)
      ).data.institutionId;
    }

    function bagliKurum() {
      return get(
        /databases/$(database)/documents/institutions/$(bagliKurumId())
      ).data;
    }

    function yonlendirilmisFirsatMi(quoteId, institutionId) {
      let talep = get(
        /databases/$(database)/documents/quoteRequests/$(quoteId)
      ).data;

      return talep.keys().hasAny(['forwardInstitutionIds'])
        && talep.forwardInstitutionIds is list
        && talep.forwardInstitutionIds.hasAny([institutionId])
        && (
          !talep.keys().hasAny(['targetInstitutionId'])
          || talep.targetInstitutionId != institutionId
        );
    }

    function yonlendirilmisFirsatKredisiVar(quoteId, institutionId) {
      return !yonlendirilmisFirsatMi(quoteId, institutionId)
        ||
        (
          exists(
            /databases/$(database)/documents/leadCreditAccounts/$(institutionId)
          )
          && get(
            /databases/$(database)/documents/leadCreditAccounts/$(institutionId)
          ).data.balance is number
          && get(
            /databases/$(database)/documents/leadCreditAccounts/$(institutionId)
          ).data.balance > 0
        );
    }

    function teklifTalebiAcik(quoteId) {
      let talep = get(
        /databases/$(database)/documents/quoteRequests/$(quoteId)
      ).data;

      return !exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
        )
        && (
          !talep.keys().hasAny(['status'])
          ||
          ![
            'done',
            'archived',
            'closed',
            'cancelled',
            'canceled',
            'completed',
            'used'
          ].hasAny([talep.status])
        );
    }

    function kurumTalebineErisebilir(quoteId) {
      let talep = get(
        /databases/$(database)/documents/quoteRequests/$(quoteId)
      ).data;

      return onayliKurumKullanicisi()
        && (
          (
            talep.keys().hasAny(['targetInstitutionId'])
            && talep.targetInstitutionId == bagliKurumId()
          )
          ||
          (
            talep.keys().hasAny(['forwardInstitutionIds'])
            && talep.forwardInstitutionIds is list
            && talep.forwardInstitutionIds.hasAny([bagliKurumId()])
          )
          ||
          (
            talep.keys().hasAny(['requestType'])
            && talep.requestType == 'bulk'
            && talep.category == bagliKurum().category
            && talep.city == bagliKurum().city
            && (
              talep.district == ''
              || talep.district == bagliKurum().district
            )
          )
        );
    }


    // =====================================================
    // SİPARİŞLER
    // =====================================================
    match /siparisler/{siparisId} {

      allow create: if true;

      allow read: if adminMi()
        || (
          girisYapmis()
          && resource.data.kullaniciId == request.auth.uid
        );

      allow update: if adminMi()
        || (
          girisYapmis()
          && resource.data.kullaniciId == request.auth.uid
          && request.resource.data.kullaniciId
              == resource.data.kullaniciId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'iptalTalebiDurumu',
                'iptalTalebiTarihi'
              ])
          && request.resource.data.iptalTalebiDurumu
              == 'Bekliyor'
        );

      allow delete: if adminMi();
    }


    // =====================================================
    // KULLANICI / YÖNETİCİ
    // =====================================================
    match /kullanicilar/{userId} {

      allow read: if girisYapmis()
        && request.auth.uid == userId;

      allow create: if adminMi()
        && request.auth.uid == userId;

      allow update: if adminMi()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'fcmToken',
              'fcmTokenGuncellemeTarihi'
            ]);

      match /bildirim_okuma/{bildirimId} {

        allow read: if girisYapmis()
          && request.auth.uid == userId;

        allow create, update: if girisYapmis()
          && request.auth.uid == userId
          && request.resource.data.okundu == true;

        allow delete: if girisYapmis()
          && request.auth.uid == userId;
      }
    }


    // =====================================================
    // DİJİYER - SİTE / YÖNETİM AYARLARI
    // =====================================================
    match /siteSettings/{settingId} {

      // Ana sayfa görünürlük/içerik ayarları kullanıcı arayüzü tarafından okunur.
      // Reklam tarifesi gibi yönetim ayarları yalnızca admin tarafından okunur.
      allow read: if settingId == 'home' || adminMi();

      // Tüm site ayarlarını yalnızca yönetici değiştirebilir.
      allow create, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - REKLAM / TANITIM
    // =====================================================

    // Kullanıcı tarafında yayındaki banner reklamları okunur.
    // Oluşturma, düzenleme ve silme yalnızca yöneticiye açıktır.
    match /bannerAds/{adId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    // Harici / affiliate reklamlar kullanıcı arayüzünde okunabilir.
    // Yönetim işlemleri yalnızca admin tarafından yapılır.
    match /externalAds/{adId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    // Reklam ve tanıtım paketleri kurum panelinde görüntülenebilir.
    // Paket tanımlama ve fiyatlandırma yalnızca admin tarafından yapılır.
    match /promotionPackages/{packageId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    // Kurum tanıtım siparişleri.
    match /promotionOrders/{orderId} {
      allow read: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
          && resource.data.userId == request.auth.uid
        );

      allow create: if
        onayliKurumKullanicisi()
        && request.resource.data.institutionId == bagliKurumId()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - RANDEVU AYARLARI
    // =====================================================
    match /appointmentSettings/{institutionId} {

      // Müşteri uygun gün/saatleri görebilsin.
      allow read: if true;

      // Kurum yalnızca kendi randevu ayarlarını yönetebilir.
      allow create, update, delete: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
        );
    }


    // =====================================================
    // DİJİYER - RANDEVULAR
    // =====================================================
    match /appointments/{appointmentId} {

      // Randevu üyelik olmadan oluşturulabilir; kişisel bilgiler herkese açılmaz.
      // Randevu ve saat kilidi aynı transaction/batch içinde oluşturulmalıdır.
      allow create: if
        request.resource.data.keys().hasOnly([
          'institutionId',
          'institutionName',
          'customerName',
          'customerPhone',
          'service',
          'date',
          'time',
          'durationMinutes',
          'note',
          'slotId',
          'bookingCode',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.institutionId is string
        && request.resource.data.institutionId.size() > 0
        && request.resource.data.institutionName is string
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 10
        && request.resource.data.customerPhone.size() <= 20
        && request.resource.data.get('service', '') is string
        && request.resource.data.get('service', '').size() > 0
        && request.resource.data.get('service', '').size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.durationMinutes in [15, 30, 45, 60]
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.slotId is string
        && request.resource.data.slotId.size() > 0
        && request.resource.data.bookingCode is string
        && request.resource.data.bookingCode.size() == 8
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && getAfter(
          /databases/$(database)/documents/appointmentSlots/$(request.resource.data.institutionId)/slots/$(request.resource.data.slotId)
        ).data.appointmentId == appointmentId
        && getAfter(
          /databases/$(database)/documents/appointmentSlots/$(request.resource.data.institutionId)/slots/$(request.resource.data.slotId)
        ).data.institutionId == request.resource.data.institutionId
        && getAfter(
          /databases/$(database)/documents/appointmentSlots/$(request.resource.data.institutionId)/slots/$(request.resource.data.slotId)
        ).data.date == request.resource.data.date
        && getAfter(
          /databases/$(database)/documents/appointmentSlots/$(request.resource.data.institutionId)/slots/$(request.resource.data.slotId)
        ).data.time == request.resource.data.time;

      // Kişisel randevu bilgilerini yalnız yönetici veya ilgili kurum okuyabilir.
      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
        );

      // Kurum yalnızca randevu durumunu değiştirebilir.
      allow update: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in [
            'pending',
            'approved',
            'rejected',
            'completed',
            'cancelled'
          ]
          && request.resource.data.updatedAt is string
        );

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - RANDEVU DOLU SAAT KİLİTLERİ
    // =====================================================
    match /appointmentSlots/{institutionId}/slots/{slotId} {

      // Bu koleksiyonda kişisel bilgi yoktur; yalnız dolu saatler tutulur.
      allow get, list: if true;

      // Aynı slot dokümanı ikinci kez oluşturulamadığı için çift rezervasyon engellenir.
      allow create: if
        request.resource.data.keys().hasOnly([
          'appointmentId',
          'institutionId',
          'date',
          'time',
          'status',
          'createdAt'
        ])
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() > 0
        && request.resource.data.institutionId == institutionId
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is string
        && getAfter(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        ).data.institutionId == institutionId
        && getAfter(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        ).data.slotId == slotId
        && getAfter(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        ).data.date == request.resource.data.date
        && getAfter(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        ).data.time == request.resource.data.time;

      // Reddedilen/iptal edilen randevunun slotunu ilgili kurum serbest bırakabilir.
      allow delete: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
        );

      allow update: if false;
    }


    // =====================================================
    // DİJİYER - KURUM BAŞVURULARI
    // =====================================================
    match /institutionApplications/{applicationId} {

      // Kurum başvurusu üyelik olmadan gönderilebilir.
      allow create: if true;

      allow read, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUMLAR
    // =====================================================
    match /institutions/{institutionId} {

      // Kurum listesi ve kurum profilleri herkese açık.
      allow read: if true;

      // Kurum kaydının kendisi yalnızca yönetici tarafından oluşturulur/değiştirilir.
      allow create, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM HESAPLARI
    // =====================================================
    match /institutionUsers/{userId} {

      // Firebase Auth hesabını oluşturan kullanıcı kendi kurum hesabı başvurusunu kaydedebilir.
      allow create: if
        girisYapmis()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'institutionId',
          'institutionName',
          'status',
          'date'
        ])
        && request.resource.data.email is string
        && request.resource.data.institutionId is string
        && request.resource.data.institutionId.size() > 0
        && request.resource.data.institutionName is string
        && request.resource.data.institutionName.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string;

      // Kullanıcı kendi başvurusunu, yönetici ise tüm hesapları okuyabilir.
      allow read: if
        adminMi()
        || (
          girisYapmis()
          && request.auth.uid == userId
        );

      // Onay/red ve diğer yönetim işlemleri sadece admin.
      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - YENİ TEKLİF TALEBİ
    // =====================================================
    match /quoteRequests/{quoteId} {

      // Toplu teklif ve tek kuruma özel teklif üyelik olmadan gönderilebilir.
      allow create: if true;

      // Yönetici tüm talepleri; onaylı kurum ise yalnızca kendisine uygun
      // toplu talepleri veya doğrudan kendisine gönderilmiş talepleri okuyabilir.
      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && (
            (
              resource.data.keys().hasAny(['targetInstitutionId'])
              && resource.data.targetInstitutionId == bagliKurumId()
            )
            ||
            (
              resource.data.keys().hasAny(['forwardInstitutionIds'])
              && resource.data.forwardInstitutionIds is list
              && resource.data.forwardInstitutionIds.hasAny([bagliKurumId()])
            )
            ||
            (
              resource.data.keys().hasAny(['requestType'])
              && resource.data.requestType == 'bulk'
              && resource.data.category == bagliKurum().category
              && resource.data.city == bagliKurum().city
              && (
                resource.data.district == ''
                || resource.data.district == bagliKurum().district
              )
            )
          )
        );

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF TAKİP KODU
    // =====================================================
    match /quoteAccess/{phoneHash}/codes/{trackingCode} {

      // Talep oluşturulduktan sonra takip kaydı anonim oluşturulabilir.
      allow create: if
        request.resource.data.quoteId is string
        && request.resource.data.quoteId.size() > 0
        && request.resource.data.trackingCode == trackingCode
        && request.resource.data.phoneHash == phoneHash
        && request.resource.data.status == 'active'
        && exists(
          /databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteId)
        );

      allow get: if
        resource.data.phoneHash == phoneHash
        && resource.data.trackingCode == trackingCode;

      allow list: if false;

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - MÜŞTERİYE AÇIK TEKLİF SÜREÇ DURUMU
    // Kişisel veri içermez; yönlendirme/yanıt durumunu takip ekranına taşır.
    // =====================================================
    match /quoteRequests/{quoteId}/publicStatus/{statusId} {
      allow get: if statusId == 'main';
      allow list: if false;
      allow create, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - GELEN FİYAT TEKLİFLERİ
    // =====================================================
    match /quoteRequests/{quoteId}/offers/{institutionId} {

      // Teklif takip ekranı fiyat tekliflerini okuyabilir.
      allow get, list: if true;

      // Normalde yalnızca talebe erişebilen onaylı kurum kendi teklifini oluşturur.
      // Yönetici ise kurum paneli kurulmadan teklif/kredi akışını test edebilmek için
      // yönetim panelinden test teklifi oluşturabilir.
      allow create: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
        && kurumTalebineErisebilir(quoteId)
        && teklifTalebiAcik(quoteId)
        && yonlendirilmisFirsatKredisiVar(quoteId, institutionId)
        && request.resource.data.keys().hasOnly([
          'institutionId',
          'institutionName',
          'offerCode',
          'price',
          'vatStatus',
          'scope',
          'extraFee',
          'conditions',
          'expiresAt',
          'expiresAtTs',
          'status',
          'validityHours',
          'registrationRequired',
          'platformPayment',
          'paymentPolicy',
          'offerVersion',
          'sourceType',
          'sourceLabel',
          'secondOfferSentAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.institutionId == institutionId
        && request.resource.data.offerCode is string
        && request.resource.data.offerCode.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.scope is string
        && request.resource.data.scope.size() > 0
        && request.resource.data.status == 'offered'
        && request.resource.data.validityHours is number
        && request.resource.data.validityHours > 0
        && request.resource.data.registrationRequired == true
        && request.resource.data.platformPayment == false
        && request.resource.data.paymentPolicy
            == 'offline_direct_between_customer_and_institution'
        && request.resource.data.offerVersion is number
        && request.resource.data.offerVersion >= 1
        && request.resource.data.sourceType is string
        && request.resource.data.sourceLabel is string
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.expiresAtTs > request.time
        );

      // Müşteri teklifi kabul ettikten sonra teklif değiştirilemez.
      allow update: if
        onayliKurumKullanicisi()
        && bagliKurumId() == institutionId
        && kurumTalebineErisebilir(quoteId)
        && teklifTalebiAcik(quoteId)
        && resource.data.institutionId == institutionId
        && request.resource.data.institutionId == institutionId
        && request.resource.data.offerCode == resource.data.offerCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'offered'
        && !exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
        )
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'institutionName',
              'price',
              'vatStatus',
              'scope',
              'extraFee',
              'conditions',
              'expiresAt',
              'expiresAtTs',
              'status',
              'validityHours',
              'registrationRequired',
              'platformPayment',
              'paymentPolicy',
              'offerVersion',
              'sourceType',
              'sourceLabel',
              'secondOfferSentAt',
              'updatedAt'
            ])
        && request.resource.data.registrationRequired == true
        && request.resource.data.platformPayment == false
        && request.resource.data.paymentPolicy
            == 'offline_direct_between_customer_and_institution'
        && request.resource.data.offerVersion is number
        && request.resource.data.offerVersion >= 1
        && request.resource.data.sourceType is string
        && request.resource.data.sourceLabel is string
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.expiresAtTs > request.time;

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - 2. TEKLİF DAVETİ
    // Yönetim, açık ve kabul edilmemiş teklif için kuruma ikinci teklif fırsatı açar.
    // =====================================================
    match /quoteRequests/{quoteId}/secondOfferInvites/{institutionId} {

      allow get: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
        );

      allow list: if adminMi();

      allow create: if
        adminMi()
        && request.resource.data.keys().hasOnly([
          'institutionId',
          'institutionName',
          'status',
          'reason',
          'firstOfferPrice',
          'offerVersion',
          'invitedAt',
          'expiresAt',
          'decision',
          'respondedAt'
        ])
        && request.resource.data.institutionId == institutionId
        && request.resource.data.institutionName is string
        && request.resource.data.status == 'open'
        && request.resource.data.reason == 'customer_no_response'
        && request.resource.data.firstOfferPrice is number
        && request.resource.data.firstOfferPrice > 0
        && request.resource.data.offerVersion == 1
        && request.resource.data.invitedAt is string
        && request.resource.data.expiresAt is string
        && request.resource.data.decision == ''
        && request.resource.data.respondedAt == ''
        && exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(institutionId)
        )
        && !exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
        );

      allow update: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
          && resource.data.institutionId == institutionId
          && resource.data.status == 'open'
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.institutionName == resource.data.institutionName
          && request.resource.data.status == resource.data.status
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.firstOfferPrice == resource.data.firstOfferPrice
          && request.resource.data.offerVersion == resource.data.offerVersion
          && request.resource.data.invitedAt == resource.data.invitedAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'decision',
                'respondedAt'
              ])
          && (
            request.resource.data.decision == 'yes'
            || request.resource.data.decision == 'no'
          )
          && request.resource.data.respondedAt is string
          && request.resource.data.respondedAt.size() > 0
        );

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF GEÇMİŞİ
    // 2. teklif gönderilmeden önce önceki teklifin salt-okunur kopyası saklanır.
    // =====================================================
    match /quoteRequests/{quoteId}/offerHistory/{historyId} {

      allow get, list: if true;

      allow create: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && request.resource.data.keys().hasOnly([
            'quoteId',
            'institutionId',
            'institutionName',
            'offerCode',
            'version',
            'price',
            'vatStatus',
            'scope',
            'extraFee',
            'conditions',
            'expiresAt',
            'sourceType',
            'sourceLabel',
            'createdAt',
            'updatedAt',
            'archivedAt'
          ])
          && request.resource.data.quoteId == quoteId
          && request.resource.data.institutionId == bagliKurumId()
          && request.resource.data.version is number
          && request.resource.data.version >= 1
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.offerCode is string
          && request.resource.data.offerCode.size() > 0
          && request.resource.data.archivedAt is string
          && exists(
            /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
          )
          && request.resource.data.offerCode
              == get(
                /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
              ).data.offerCode
          && request.resource.data.version
              == get(
                /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
              ).data.offerVersion
          && request.resource.data.price
              == get(
                /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
              ).data.price
          && !exists(
            /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
          )
        );

      allow update: if false;
      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF KODU / QR DOĞRULAMA İNDEKSİ
    // =====================================================
    match /offerLookup/{offerCode} {

      allow get: if true;
      allow list: if false;

      allow create: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && request.resource.data.keys().hasOnly([
          'quoteId',
          'institutionId',
          'offerCode',
          'updatedAt'
        ])
        && request.resource.data.institutionId == bagliKurumId()
        && request.resource.data.offerCode == offerCode
        && kurumTalebineErisebilir(request.resource.data.quoteId)
        );

      allow update: if
        onayliKurumKullanicisi()
        && resource.data.institutionId == bagliKurumId()
        && request.resource.data.quoteId == resource.data.quoteId
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.offerCode == resource.data.offerCode
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['updatedAt']);

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF KABULÜ / GERÇEK KAYIT
    // =====================================================
    match /quoteRequests/{quoteId}/locks/{lockId} {

      allow get: if lockId == 'main';
      allow list: if false;

      // Müşteri, telefon özeti + takip koduyla doğrulanmış kendi talebindeki
      // aktif tekliflerden yalnızca birini kabul edebilir.
      allow create: if
        lockId == 'main'
        && !exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
        )
        && request.resource.data.keys().hasOnly([
          'quoteId',
          'institutionId',
          'institutionName',
          'offerCode',
          'price',
          'lockedPrice',
          'vatStatus',
          'scope',
          'lockedScope',
          'conditions',
          'extraFee',
          'offerCreatedAt',
          'offerUpdatedAt',
          'offerVersion',
          'offerSnapshotVersion',
          'trackingCode',
          'phoneHash',
          'acceptanceConsent',
          'status',
          'registrationStatus',
          'acceptedAt',
          'acceptedAtTs',
          'lockedAt',
          'lockedAtTs',
          'expiresAt',
          'expiresAtTs',
          'registrationDeadlineAt',
          'registrationDeadlineAtTs',
          'platformPayment',
          'paymentPolicy'
        ])
        && request.resource.data.quoteId == quoteId
        && request.resource.data.status == 'locked'
        && request.resource.data.registrationStatus == 'pending'
        && request.resource.data.acceptanceConsent == true
        && request.resource.data.offerSnapshotVersion == 1
        && request.resource.data.platformPayment == false
        && request.resource.data.paymentPolicy
            == 'offline_direct_between_customer_and_institution'
        && request.resource.data.acceptedAtTs == request.time
        && request.resource.data.lockedAtTs == request.time
        && request.resource.data.trackingCode is string
        && request.resource.data.trackingCode.size() > 0
        && request.resource.data.phoneHash is string
        && request.resource.data.phoneHash.size() > 0
        && exists(
          /databases/$(database)/documents/quoteAccess/$(request.resource.data.phoneHash)/codes/$(request.resource.data.trackingCode)
        )
        && get(
          /databases/$(database)/documents/quoteAccess/$(request.resource.data.phoneHash)/codes/$(request.resource.data.trackingCode)
        ).data.quoteId == quoteId
        && exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
        )
        && request.resource.data.offerCode
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.offerCode
        && request.resource.data.price
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.price
        && request.resource.data.lockedPrice
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.price
        && request.resource.data.scope
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.scope
        && request.resource.data.lockedScope
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.scope
        && request.resource.data.institutionName
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.institutionName
        && request.resource.data.vatStatus
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.vatStatus
        && request.resource.data.conditions
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.conditions
        && request.resource.data.extraFee
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.extraFee
        && request.resource.data.offerCreatedAt
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.createdAt
        && request.resource.data.offerUpdatedAt
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.updatedAt
        && request.resource.data.offerVersion
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.updatedAt
        && request.resource.data.expiresAt
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.expiresAt
        && request.resource.data.expiresAtTs
            == get(
              /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
            ).data.expiresAtTs
        && request.resource.data.registrationDeadlineAt
            == request.resource.data.expiresAt
        && request.resource.data.registrationDeadlineAtTs
            == request.resource.data.expiresAtTs
        && request.time < request.resource.data.expiresAtTs;

      // Gerçek kaydı yalnızca teklifi veren kurum ve süre dolmadan tamamlayabilir.
      allow update: if
        lockId == 'main'
        && onayliKurumKullanicisi()
        && bagliKurumId() == resource.data.institutionId
        && resource.data.status == 'locked'
        && resource.data.registrationStatus == 'pending'
        && request.resource.data.status == 'used'
        && request.resource.data.registrationStatus == 'completed'
        && request.resource.data.registrationCompletedAtTs == request.time
        && request.resource.data.usedAtTs == request.time
        && request.time < resource.data.registrationDeadlineAtTs
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'registrationStatus',
              'registrationCompletedAt',
              'registrationCompletedAtTs',
              'usedAt',
              'usedAtTs'
            ]);

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM CEVAPLARI
    // =====================================================
    match /quoteResponses/{responseId} {

      allow read: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
          && resource.data.userId == request.auth.uid
        );

      allow create, update: if
        onayliKurumKullanicisi()
        && request.resource.data.keys().hasOnly([
          'quoteId',
          'institutionId',
          'userId',
          'status',
          'date'
        ])
        && request.resource.data.institutionId == bagliKurumId()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.status == 'interested'
          || request.resource.data.status == 'not_interested'
        )
        && kurumTalebineErisebilir(request.resource.data.quoteId);

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM YANITLARI / ENGAGEMENT
    // =====================================================
    match /quoteRequests/{quoteId}/engagement/{institutionId} {

      // Müşteri takip ekranı kurum yanıtlarını okuyabilir.
      allow get, list: if true;

      // Müşteri tarafı: görüntüleme ve revizyon talebi.
      allow create: if
        (
          request.resource.data.institutionId == institutionId
          && request.resource.data.keys().hasOnly([
            'institutionId',
            'viewedAt',
            'viewedAtTs',
            'lastCustomerActionAt',
            'revisionRequestedAt',
            'revisionRequestedAtTs'
          ])
        )
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
          && kurumTalebineErisebilir(quoteId)
          && request.resource.data.institutionId == institutionId
          && request.resource.data.keys().hasOnly([
            'institutionId',
            'institutionName',
            'institutionResponse',
            'institutionResponseAt',
            'lastInstitutionActionAt',
            'revisionRespondedAt',
            'revisionRespondedAtTs'
          ])
        );

      allow update: if
        (
          request.resource.data.institutionId == institutionId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'viewedAt',
                'viewedAtTs',
                'lastCustomerActionAt',
                'revisionRequestedAt',
                'revisionRequestedAtTs'
              ])
        )
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
          && kurumTalebineErisebilir(quoteId)
          && request.resource.data.institutionId == institutionId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'institutionName',
                'institutionResponse',
                'institutionResponseAt',
                'lastInstitutionActionAt',
                'revisionRespondedAt',
                'revisionRespondedAtTs'
              ])
        );

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF MESAJLAŞMASI
    // =====================================================
    match /quoteRequests/{quoteId}/conversations/{institutionId}/messages/{messageId} {

      allow get, list: if true;

      allow create: if
        request.resource.data.institutionId == institutionId
        && (
          request.resource.data.sender == 'customer'
          ||
          (
            request.resource.data.sender == 'institution'
            && onayliKurumKullanicisi()
            && bagliKurumId() == institutionId
            && kurumTalebineErisebilir(quoteId)
          )
        );

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - GÜNLÜK TEKLİF / KABUL İSTATİSTİĞİ
    // =====================================================
    match /publicOfferEvents/{eventId} {
      allow get: if true;
      allow list: if true;

      allow create: if
        onayliKurumKullanicisi()
        && request.resource.data.institutionId == bagliKurumId()
        && kurumTalebineErisebilir(request.resource.data.quoteId);

      allow update, delete: if adminMi();
    }

    match /publicAcceptedEvents/{eventId} {
      allow get: if true;
      allow list: if true;

      allow create: if
        request.resource.data.quoteId == eventId
        && request.resource.data.date is string;

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF SORUN BİLDİRİMİ
    // =====================================================
    match /quoteRequests/{quoteId}/offerIssues/{issueId} {

      allow create: if
        request.resource.data.offerCode is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == "new"
        && request.resource.data.date is string;

      allow read, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM YORUMLARI / TAVSİYE OYLARI
    // =====================================================
    // =====================================================
    // DİJİYER - KURUM ANALİTİĞİ
    // =====================================================
    match /institutionAnalytics/{eventId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'institutionId',
          'type',
          'day',
          'date'
        ])
        && request.resource.data.institutionId is string
        && request.resource.data.institutionId.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 80
        && request.resource.data.day is string
        && request.resource.data.date is string;

      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
        );

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - BULUNAMAYAN ARAMALAR
    // =====================================================
    match /unmatchedSearches/{searchId} {
      allow create: if
        request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 180
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is string;

      allow get, list, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM DESTEK TALEPLERİ
    // =====================================================
    match /supportTickets/{ticketId} {
      allow create: if
        onayliKurumKullanicisi()
        && request.resource.data.institutionId == bagliKurumId()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new';

      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF KREDİ HESAPLARI
    // =====================================================
    match /leadCreditAccounts/{institutionId} {
      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && bagliKurumId() == institutionId
        );

      allow create, update, delete: if adminMi();
    }

    match /leadCreditLedger/{entryId} {
      allow get, list: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && resource.data.institutionId == bagliKurumId()
        );

      allow create, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - İSTEMCİ HATA KAYITLARI
    // Anonim ziyaretçi yazamaz; yalnızca yönetici veya onaylı kurum hesabı.
    // =====================================================
    match /clientErrors/{errorId} {
      allow create: if
        adminMi()
        ||
        (
          onayliKurumKullanicisi()
          && request.resource.data.keys().hasOnly([
            'source',
            'page',
            'message',
            'stack',
            'date',
            'status',
            'userId',
            'institutionId'
          ])
          && request.resource.data.source == 'institution'
          && request.resource.data.status == 'new'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.institutionId == bagliKurumId()
          && request.resource.data.page is string
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.stack is string
          && request.resource.data.stack.size() <= 5000
          && request.resource.data.date is string
        );

      allow get, list, update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - İŞ & TİCARET FIRSATLARI
    // =====================================================
    match /businessOpportunities/{opportunityId} {
      // Ziyaretçiler yalnızca yayındaki fırsatları okuyabilir.
      allow get, list: if
        adminMi()
        || resource.data.status == 'published';

      // Manuel giriş, otomatik kaynak onayı ve tüm yönetim işlemleri yalnızca admin.
      allow create, update, delete: if adminMi();
    }


    match /institutionReviews/{reviewId} {

      // Ziyaretçiler yalnızca onaylanmış yorumları görebilir.
      // Yönetici moderasyon kuyruğundaki tüm kayıtları görebilir.
      allow get, list: if
        adminMi()
        || resource.data.status == 'published';

      // Yeni yorumlar doğrudan yayınlanmaz; önce moderasyon kuyruğuna düşer.
      allow create: if
        request.resource.data.keys().hasOnly([
          'institutionId',
          'rating',
          'recommend',
          'text',
          'status',
          'date'
        ])
        && request.resource.data.institutionId is string
        && request.resource.data.institutionId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (
          !request.resource.data.keys().hasAny(['recommend'])
          || request.resource.data.recommend is bool
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string;

      allow update, delete: if adminMi();
    }

  }
}
