rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis() {
      return request.auth != null;
    }

    function adminMi() {
      return girisYapmis()
        && request.auth.uid == "jTN0GipmU3RtqbWaChuJY0XBUSg1";
    }


    // =====================================================
    // SİPARİŞLER
    // =====================================================
    match /siparisler/{siparisId} {

      allow create: if true;

      allow read: if adminMi()
        || (
          girisYapmis()
          && resource.data.kullaniciId == request.auth.uid
        );

      allow update: if adminMi()
        || (
          girisYapmis()
          && resource.data.kullaniciId == request.auth.uid
          && request.resource.data.kullaniciId
              == resource.data.kullaniciId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'iptalTalebiDurumu',
                'iptalTalebiTarihi'
              ])
          && request.resource.data.iptalTalebiDurumu
              == 'Bekliyor'
        );

      allow delete: if adminMi();
    }


    // =====================================================
    // KULLANICI / YÖNETİCİ
    // =====================================================
    match /kullanicilar/{userId} {

      allow read: if girisYapmis()
        && request.auth.uid == userId;

      allow create: if adminMi()
        && request.auth.uid == userId;

      allow update: if adminMi()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'fcmToken',
              'fcmTokenGuncellemeTarihi'
            ]);

      match /bildirim_okuma/{bildirimId} {

        allow read: if girisYapmis()
          && request.auth.uid == userId;

        allow create, update: if girisYapmis()
          && request.auth.uid == userId
          && request.resource.data.okundu == true;

        allow delete: if girisYapmis()
          && request.auth.uid == userId;
      }
    }


    // =====================================================
    // DİJİYER - YENİ TEKLİF TALEBİ
    // =====================================================
    match /quoteRequests/{quoteId} {

      // Üyeliksiz toplu teklif ve tek kuruma doğrudan teklif oluşturulabilir.
      allow create: if
        request.resource.data.keys().hasOnly([
          'mainCategory',
          'subCategory',
          'category',
          'service',
          'city',
          'district',
          'name',
          'phone',
          'email',
          'note',
          'status',
          'date',
          'requestType',
          'targetInstitutionId',
          'targetInstitutionName'
        ])

        && request.resource.data.mainCategory is string
        && request.resource.data.subCategory is string
        && request.resource.data.category is string
        && request.resource.data['service'] is string
        && request.resource.data.city is string
        && request.resource.data.district is string

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120

        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 30

        && (
          !request.resource.data.keys().hasAny(['email'])
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 160
          )
        )

        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500

        && request.resource.data.status == 'new'
        && request.resource.data.date is string

        // Toplu teklifte hedef kurum alanları bulunmaz.
        // Doğrudan teklifte üç alan birlikte bulunur ve kurum doğrulanır.
        && (
          !request.resource.data.keys().hasAny([
            'requestType',
            'targetInstitutionId',
            'targetInstitutionName'
          ])

          ||

          (
            request.resource.data.keys().hasAll([
              'requestType',
              'targetInstitutionId',
              'targetInstitutionName'
            ])
            && request.resource.data.requestType == 'direct'
            && request.resource.data.targetInstitutionId is string
            && request.resource.data.targetInstitutionId.size() > 0
            && request.resource.data.targetInstitutionName is string
            && request.resource.data.targetInstitutionName.size() > 0

            && exists(
              /databases/$(database)/documents/institutions/$(request.resource.data.targetInstitutionId)
            )

            && request.resource.data.targetInstitutionName == get(
              /databases/$(database)/documents/institutions/$(request.resource.data.targetInstitutionId)
            ).data.name
          )
        );

      // Ana talep içerisindeki müşteri bilgileri halka açık değildir.
      allow get, list: if adminMi();

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF TAKİP KODU
    // =====================================================
    match /quoteAccess/{phoneHash}/codes/{trackingCode} {

      // Yeni talep oluşturulduğunda takip kodu kaydedilir.
      // Doğrudan tekliflerde hedef kurum bilgisi de burada tutulur.
      allow create: if
        request.resource.data.keys().hasOnly([
          'quoteId',
          'trackingCode',
          'phoneHash',
          'service',
          'mainCategory',
          'subCategory',
          'mainCategoryLabel',
          'subCategoryLabel',
          'city',
          'district',
          'email',
          'note',
          'date',
          'status',
          'createdAt',
          'requestType',
          'targetInstitutionId',
          'targetInstitutionName'
        ])

        && request.resource.data.quoteId is string
        && request.resource.data.trackingCode == trackingCode
        && request.resource.data.phoneHash == phoneHash

        && request.resource.data['service'] is string
        && request.resource.data.mainCategory is string
        && request.resource.data.subCategory is string
        && request.resource.data.mainCategoryLabel is string
        && request.resource.data.subCategoryLabel is string
        && request.resource.data.city is string
        && request.resource.data.district is string

        && (
          !request.resource.data.keys().hasAny(['email'])
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 160
          )
        )

        && request.resource.data.note is string
        && request.resource.data.date is string

        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is string

        && exists(
          /databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteId)
        )

        // Toplu takip kaydında hedef kurum alanları bulunmaz.
        // Doğrudan takip kaydında hedef kurum, ana talep ile aynı olmalıdır.
        && (
          !request.resource.data.keys().hasAny([
            'requestType',
            'targetInstitutionId',
            'targetInstitutionName'
          ])

          ||

          (
            request.resource.data.keys().hasAll([
              'requestType',
              'targetInstitutionId',
              'targetInstitutionName'
            ])
            && request.resource.data.requestType == 'direct'
            && request.resource.data.targetInstitutionId is string
            && request.resource.data.targetInstitutionName is string

            && get(
              /databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteId)
            ).data.targetInstitutionId
              == request.resource.data.targetInstitutionId

            && get(
              /databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteId)
            ).data.targetInstitutionName
              == request.resource.data.targetInstitutionName
          )
        );

      // Telefon hash + takip kodu doğruysa açılır.
      allow get: if
        resource.data.phoneHash == phoneHash
        && resource.data.trackingCode == trackingCode;

      // Takip kodları topluca listelenemez.
      allow list: if false;

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - GELEN FİYAT TEKLİFLERİ
    // AŞAMA 2A
    // =====================================================
    match /quoteRequests/{quoteId}/offers/{institutionId} {

      allow get, list: if true;

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - FİYAT KİLİDİ
    // AŞAMA 2B
    // =====================================================
    match /quoteRequests/{quoteId}/locks/{lockId} {

      // Müşteri yalnızca ana kilit kaydını okuyabilir.
      allow get: if lockId == "main";

      allow list: if false;


      // Müşteri seçtiği teklifi kilitleyebilir.
      allow create: if
        lockId == "main"

        && !exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/locks/main
        )

        && request.resource.data.quoteId == quoteId

        && request.resource.data.status == "locked"

        && request.resource.data.institutionId is string
        && request.resource.data.offerCode is string

        && request.resource.data.price is number
        && request.resource.data.lockedPrice is number

        && request.resource.data.price
          == request.resource.data.lockedPrice

        && exists(
          /databases/$(database)/documents/quoteRequests/$(quoteId)/offers/$(request.resource.data.institutionId)
        );

      allow update, delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - KURUM YANITLARI / ENGAGEMENT
    // AŞAMA 2C
    // =====================================================
    match /quoteRequests/{quoteId}/engagement/{institutionId} {

      // Teklif takip ekranı kurum yanıtlarını okuyabilir.
      allow get, list: if true;

      // Müşterinin teklif görüntüleme / revizyon talebi kayıtları.
      allow create: if
        request.resource.data.institutionId == institutionId
        && request.resource.data.keys().hasOnly([
          'institutionId',
          'viewedAt',
          'viewedAtTs',
          'lastCustomerActionAt',
          'revisionRequestedAt',
          'revisionRequestedAtTs'
        ]);

      allow update: if
        request.resource.data.institutionId == institutionId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'viewedAt',
              'viewedAtTs',
              'lastCustomerActionAt',
              'revisionRequestedAt',
              'revisionRequestedAtTs'
            ]);

      allow delete: if adminMi();
    }


    // =====================================================
    // DİJİYER - TEKLİF SORUN BİLDİRİMİ
    // =====================================================
    match /quoteRequests/{quoteId}/offerIssues/{issueId} {

      allow create: if
        request.resource.data.offerCode is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == "new"
        && request.resource.data.date is string;

      allow read, update, delete: if adminMi();
    }

  }
}
